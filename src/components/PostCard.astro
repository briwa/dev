---
const { entry } = Astro.props;
const { cover, href } = entry;
---

<div class="jr-card">
  <a class="jr-card-link" href={href} aria-label={entry.title}></a>
  {cover ? (
    <a class="jr-cover jr-card-cover" href={href} tabindex="-1" aria-hidden="true" style={`--fig-ar: ${cover.w} / ${cover.h}`}>
      <iframe
        class="jr-cover-frame"
        sandbox="allow-scripts"
        srcdoc={cover.srcdoc}
        title="figure preview"
        tabindex="-1"
      ></iframe>
    </a>
  ) : (
    <p class="jr-card-excerpt">{entry.excerpt}</p>
  )}
  <span class="jr-card-title">{entry.title}</span>
</div>
