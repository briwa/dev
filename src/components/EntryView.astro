---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { postHref } from '../lib/posts.js';

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title}>
  <article id="entry-view">
    <h1 class="entry-h1">{post.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>

  {(newer || older) && (
    <nav class="entry-nav">
      {newer ? (
        <a class="entry-nav-link prev" href={postHref(newer)}>
          <span class="nav-arrow">←</span>
          <span class="nav-t">{newer.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}
      {older ? (
        <a class="entry-nav-link next" href={postHref(older)}>
          <span class="nav-t">{older.data.title}</span>
          <span class="nav-arrow">→</span>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  )}

  <a class="back" href="/">← Home</a>

</Base>
